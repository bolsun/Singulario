msgid "W, A, S, D — перемещение камеры"
msgstr "W, A, S, D — move camera"

msgid "Колесо мыши — масштаб"
msgstr "Mouse wheel — zoom"

msgid "G — сетка"
msgstr "G — grid"

msgid "ЛКМ — поставить, ПКМ — убрать"
msgstr "LMB — place, RMB — remove"

msgid "Q — взять атом под курсором как образец"
msgstr "Q — pick the atom under the cursor as a template"

